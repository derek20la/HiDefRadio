<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Milestone 9d: the VFD (vacuum-fluorescent display) look.
         vfd_on    = a lit segment: the blue-green glow of an 80s tuner / VCR
         vfd_glow  = the halo around lit segments (a see-through vfd_on)
         vfd_ghost = unlit segments, just visible behind the digits, like a real VFD
         vfd_panel = the dark glass the display sits behind -->
    <color name="vfd_on">#FF4DF5D2</color>
    <color name="vfd_glow">#B34DF5D2</color>
    <color name="vfd_ghost">#1F4DF5D2</color>
    <color name="vfd_panel">#FF070D0C</color>
    <color name="vfd_panel_edge">#FF1C2826</color>

    <!-- 9d: the sync dot in the signal line -->
    <color name="signal_good">#FF3DDC84</color>
    <color name="signal_holding">#FFFFB300</color>
    <color name="signal_lost">#FFFF5252</color>
    <color name="signal_off">#FF808080</color>

    <!-- 9e step 1: presets. The star when this station is a preset (★ gold),
         and the border of the tile you're listening to (the VFD color). -->
    <color name="preset_star_on">#FFFFC107</color>
    <color name="preset_tile_edge">#55808080</color>
    <color name="preset_tile_current">#FF4DF5D2</color>
</resources>
