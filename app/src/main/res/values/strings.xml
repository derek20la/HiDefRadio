    <string name="local_network_not_now">Not now</string>
    <string name="tcp_local_network_off">Local network access is off, so the rtl_tcp server can\'t be reached. Allow it in Android\'s settings: Apps &gt; HiDef Radio &gt; Permissions &gt; Nearby devices.</string>
    <string name="tcp_local_network_off_short">Local network access is off</string>
    <string name="open_app_settings">Settings</string>
    <string name="setting_am_deemph">AM de-emphasis (NRSC)</string>   <!-- build 21 -->
    <string name="setting_am_deemph_help">Takes out the treble boost AM stations add before they transmit, like an AM radio built to the NRSC standard: less hiss, and closer to the HD sound when the blend moves. Turn it off for flat audio (some DXers like the extra treble on weak voices).</string>
