    <string name="setting_hd_mode">HD Radio</string>   <!-- M11 -->
    <string name="setting_hd_mode_help">Auto plays the analog FM at once and blends to the HD audio when it is good, like a car radio - and back before a dropout. Digital only is HD only (silence without HD). Analog only switches the HD decoder off (saves battery). AM stations are always HD only.</string>   <!-- 11d; 12a step 3 -->
    <string name="setting_fm_stereo">FM stereo</string>   <!-- 11b step 2 -->
    <string name="setting_fm_stereo_help">Auto blends to mono as the signal gets noisy, like a car radio (ST on the signal line = stereo). Always mono cuts the hiss of weak DX stations.</string>
    <string name="setting_hd_mismatch">If the HD signal is another station\'s</string>   <!-- 11d: Auto only -->

