    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_installed">Installed %1$s</string>
    <string name="about_license">Free software (GNU GPL v3 or later)</string>
    <string name="about_license_summary">Comes with ABSOLUTELY NO WARRANTY. Tap to read the license.</string>
    <string name="about_source">Source code</string>
    <string name="source_url" translatable="false">https://github.com/derek20la/HiDefRadio</string>
    <string name="source_url_short" translatable="false">github.com/derek20la/HiDefRadio</string>
    <string name="about_licenses">Open-source licenses</string>
    <string name="about_licenses_summary">nrsc5, librtlsdr, libusb, FFTW, FAAD2, DSEG font, AndroidX</string>
