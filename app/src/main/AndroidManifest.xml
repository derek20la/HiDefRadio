<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- This app needs a phone that can act as a USB host (USB-OTG). -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Milestone 8: keep playing in the background (foreground service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Show the "now playing" notification (Android 13+ asks the user) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU awake with the screen off while the radio plays -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HiDefRadio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to open this app when a supported SDR dongle is plugged in -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <!-- ...and which dongles count as "supported" (res/xml/device_filter.xml) -->
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Milestone 9e step 2: the settings screen (⚙). The ← arrow goes back to MainActivity. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity" />

        <!-- Milestone 8: the radio engine runs here, even with the screen off -->
        <service
            android:name=".RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>